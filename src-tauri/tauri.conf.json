{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "ai-os",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": false,
        "exists": true,
        "readFile": true,
        "scope": [
          "**",
          "$HOME/**",
          "/**",
          "$HOME/**/.ai-os/*",
          "$HOME/**/.ai-os/**/*",
          "$HOME/projects/**/.ai-os/*",
          "$HOME/projects/**/.ai-os/**/*"
        ]
      },
      "shell": {
        "all": false,
        "open": true
      },
      "globalShortcut": {
        "all": true
      }
    },
    "windows": [
      {
        "title": "ai-os",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "dangerousRemoteDomainIpcAccess": [
        {
          "domain": "gemini.google.com",
          "windows": ["floating"],
          "enableTauriAPI": true
        }
      ]
    },
    "bundle": {
      "active": true,
      "targets": "app",
      "identifier": "com.matthewmurphy.ai-os",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    }
  }
}