#!/usr/bin/env python3
"""Hey Claude: handle a spoken request locally, with a quick `claude -p`, or in the project chat.

Run by the "Hey Claude" Shortcut (Vocal Shortcuts phrase -> Dictate Text ->
Run Shell Script). Three tiers, fastest first:
  1. local commands, no model at all (open apps, search, say, lights, math, time)
  2. a headless `claude -p` (Sonnet, subscription, ~5s + tool calls) for quick
     tasks and questions; the answer is spoken and shown on screen
  3. the Everything project chat in the Claude app, for big work: when Claude
     answers ESCALATE, or the request starts with "project" / "tell the project".
     Pasted by the Hammerspoon module ~/.hammerspoon/modules/hey_claude.lua.

  hey-claude "open safari"             local: opens Safari
  hey-claude "lights off"              local: Hue
  hey-claude "remind me to ..."        quick: claude -p
  hey-claude "project, fix the ..."    project chat
  hey-claude --dry-run "..."           print the route, do nothing
  hey-claude --no-send "..."           paste into the chat box but don't press Return
Text can also come on stdin.
"""
import os
import re
import subprocess
import sys
import time
from pathlib import Path

AIOS = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(AIOS / "scripts"))

HS = "/usr/local/bin/hs"
CLAUDE_CONTROL = str(Path.home() / ".hammerspoon" / "bin" / "claude-control")
HUE = [sys.executable, str(AIOS / "scripts" / "hue.py")]
LOG = AIOS / "tmp" / "hey-claude.log"

WAKE = re.compile(r"^\s*((hey|hi|okay|ok)[\s,]+)?(claude|clod|cloud|claud)\b[\s,.!:]*", re.I)
OPEN = re.compile(r"^(open|launch|start)\s+(\S+\s*){1,3}$", re.I)  # short targets only: "open the PR for X" is a request
SEARCH = re.compile(r"^(google|search)\s+\S", re.I)
SAY = re.compile(r"^say\s+\S", re.I)
LIGHTS = re.compile(
    r"^(turn\s+)?(the\s+)?lights?\s+(?P<a>on|off|up|down|dim|bright|brighter|dimmer)$"
    r"|^turn\s+(?P<b>on|off)\s+(the\s+)?lights?$"
    r"|^(set\s+)?(the\s+)?lights?\s+(to\s+)?(?P<pct>\d{1,3})\s*(%|percent)?$", re.I)
VIDEO = re.compile(r"^(?P<verb>play|pause|resume|unpause|stop)\s+(the\s+)?(youtube\s+)?(video|youtube)$", re.I)
TIME = re.compile(r"what('s| is) the time|what time is it", re.I)
PROJECT = re.compile(r"^(tell|ask|send (it|this) to)?\s*(the\s+)?project\b[\s,.:]*", re.I)

QUICK_MODEL = "sonnet"
QUICK_TIMEOUT = 120
QUICK_CWD = Path.home()  # no project CLAUDE.md to load; ~/.claude/CLAUDE.md still applies
QUICK_TOOLS = [
    "Read", "WebSearch", "WebFetch",
    "Bash(osascript:*)", "Bash(open:*)", "Bash(shortcuts run:*)", "Bash(apple-reminders:*)",
    "Bash(python3 ~/projects/ai-os/scripts/hue.py:*)", "Bash(python3 /Users/matt/projects/ai-os/scripts/hue.py:*)",
    "Bash(~/.hammerspoon/bin/claude-control:*)", "Bash(say:*)", "Bash(date:*)", "Bash(cal:*)",
    "Bash(~/projects/ai-os/scripts/youtube.sh:*)", "Bash(/Users/matt/projects/ai-os/scripts/youtube.sh:*)",
    "Bash(pmset -g:*)", "Bash(pgrep:*)", "Bash(ps:*)", "Bash(SwitchAudioSource:*)", "Bash(defaults read:*)",
]
QUICK_PROMPT = """You are Hey Claude, Matt's voice assistant on his Mac. He spoke this request; your final \
reply is read aloud with macOS `say` and shown briefly on screen, so answer in one or two short plain \
sentences with no markdown, lists or URLs.
Do quick tasks yourself with Bash (osascript, open, shortcuts run, apple-reminders, \
python3 ~/projects/ai-os/scripts/hue.py, ~/projects/ai-os/scripts/youtube.sh play|pause|status for YouTube \
in Chrome, etc.) in as few tool calls as possible. Speed matters more than polish.
Reply with exactly ESCALATE and nothing else, without doing anything, when the request needs real work \
(coding, research, multi-step projects, anything over about a minute or needing back-and-forth), or is \
hard to undo (deleting files or data, sending messages or emails to people, purchases, posting publicly).
Before any synthetic keyboard or mouse input, run ~/.hammerspoon/bin/claude-control ask "<what>" 2 \
and stop if it exits non-zero; it prints "granted <ticket>"; afterwards run \
~/.hammerspoon/bin/claude-control done <ticket>."""


def log(msg: str) -> None:
    LOG.parent.mkdir(exist_ok=True)
    with LOG.open("a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")


def lua_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'


def hs_eval(lua: str, timeout: int = 4, tries: int = 3) -> str:
    # `hs -c` can hang or drop a call right after a Hammerspoon reload, so wrap
    # it in a watchdog and retry empty answers. Callers' Lua must be safe to repeat.
    for attempt in range(tries):
        try:
            r = subprocess.run(["perl", "-e", f"alarm {timeout + 1}; exec @ARGV", HS, "-t", str(timeout), "-c", lua],
                               capture_output=True, text=True, timeout=timeout + 2)
            lines = [l for l in r.stdout.splitlines() if "recursing" not in l and "Loading extension" not in l]
            if lines:
                return lines[-1].strip()
        except subprocess.TimeoutExpired:
            pass
        time.sleep(0.5)
    return ""


def notify(msg: str) -> None:
    hs_eval("hs.alert.closeAll(); hs.alert.show(%s, 3)" % lua_str(msg), timeout=2)


def speak(text: str) -> None:
    subprocess.Popen(["say", text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def clean(text: str) -> str:
    text = " ".join(text.split())
    text = WAKE.sub("", text)
    return text.strip().rstrip(".!?")


def route(q: str) -> str:
    if not q:
        return "empty"
    if PROJECT.match(q):
        return "project"
    if LIGHTS.search(q):
        return "lights"
    if VIDEO.match(q):
        return "video"
    if OPEN.match(q) or SEARCH.match(q) or SAY.match(q):
        return "direct"
    if TIME.fullmatch(q):
        return "time"
    from triage_router import evaluate_math_phrase
    if evaluate_math_phrase(q):
        return "math"
    return "quick"


def run_lights(q: str) -> bool:
    m = LIGHTS.search(q)
    word = (m.group("a") or m.group("b") or "").lower()
    if m.group("pct"):
        args = ["--on", "--bri", str(min(int(m.group("pct")), 100))]
    elif word == "off":
        args = ["--off"]
    elif word in ("on", "up", "bright", "brighter"):
        args = ["--on", "--bri", "100"]
    else:  # down / dim / dimmer
        args = ["--on", "--bri", "30"]
    return subprocess.run(HUE + ["set", "all", *args], capture_output=True).returncode == 0


def send_to_claude(q: str, submit: bool) -> bool:
    flat = " ".join(q.split())  # claude-control builds a Lua string; a raw newline breaks it
    preview = flat if len(flat) <= 80 else flat[:77] + "..."
    ask = subprocess.run([CLAUDE_CONTROL, "ask", f"Hey Claude → project chat: “{preview}”", "2"],
                         capture_output=True, text=True)
    if ask.returncode != 0:
        notify(f"Hey Claude: {ask.stdout.strip() or 'cancelled'}")
        return False
    ticket = ask.stdout.split()[-1]  # "granted t7": release only our own turn
    try:
        started = hs_eval("return heyClaude and heyClaude.send(%s, %s) or 'missing'" % (lua_str(q), "true" if submit else "false"))
        if started not in ("working", "busy"):  # "busy": a retried call found the first one running
            notify(f"Hey Claude: couldn't start ({started or 'Hammerspoon unreachable'})")
            return False
        state = "working"
        for _ in range(50):
            time.sleep(0.25)
            state = hs_eval("return heyClaude.state()") or state
            if state != "working":
                break
        log(f"  -> {state}")
        if state not in ("sent", "pasted"):
            notify(f"Hey Claude: {state}")
            return False
        return True
    finally:
        subprocess.run([CLAUDE_CONTROL, "done", ticket], capture_output=True)


def run_quick(q: str) -> str:
    """Headless Claude Code run; returns its final reply ("" on failure)."""
    cmd = ["claude", "-p", q, "--model", QUICK_MODEL, "--no-session-persistence",
           "--append-system-prompt", QUICK_PROMPT,
           # Allowlist, not bypass: a misheard request can only reach these tools.
           "--allowedTools", *QUICK_TOOLS,
           "--setting-sources", "", "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}']
    env = dict(os.environ, PATH=f"/opt/homebrew/bin:/usr/local/bin:{Path.home()}/.local/bin:{os.environ.get('PATH', '')}")
    try:
        r = subprocess.run(cmd, cwd=QUICK_CWD, capture_output=True, text=True, timeout=QUICK_TIMEOUT, env=env)
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        log(f"  -> quick failed: {e}")
        return ""
    if r.returncode != 0:
        log(f"  -> quick exit {r.returncode}: {r.stderr.strip()[-300:]}")
    return r.stdout.strip()


def quick_worker(q: str, submit: bool) -> int:
    started = time.time()
    reply = run_quick(q)
    log(f"  -> quick {time.time() - started:.1f}s: {reply[:200]!r}")
    if reply.strip().strip(".") == "ESCALATE" or not reply:
        if not reply:
            notify("Hey Claude: quick try failed, sending to the project")
        return 0 if send_to_claude(q, submit) else 1
    hs_eval("hs.alert.closeAll(); hs.alert.show(%s, %d)" % (lua_str(reply), min(4 + len(reply) // 25, 15)), timeout=2)
    speak(reply)
    return 0


def main() -> int:
    args = sys.argv[1:]
    dry = "--dry-run" in args
    submit = "--no-send" not in args
    worker = "--worker" in args
    text = " ".join(a for a in args if a not in ("--dry-run", "--no-send", "--worker"))
    if worker:
        return quick_worker(text, submit)
    if not text.strip() and not sys.stdin.isatty():
        text = sys.stdin.read()
    q = clean(text)
    kind = route(q)
    log(f"{kind}: {q!r}")
    if dry:
        print(f"{kind}: {q}")
        return 0
    if kind == "empty":
        notify("Hey Claude: didn't catch that")
        return 1
    if kind == "lights":
        ok = run_lights(q)
        notify("💡 " + q if ok else "Hey Claude: lights failed")
        return 0 if ok else 1
    if kind == "video":
        verb = VIDEO.match(q).group("verb").lower()
        action = "pause" if verb in ("pause", "stop") else "play"
        env = dict(os.environ, PATH=f"/opt/homebrew/bin:/usr/local/bin:{Path.home()}/.local/bin:{os.environ.get('PATH', '')}")
        r = subprocess.run([str(AIOS / "scripts" / "youtube.sh"), action], capture_output=True, text=True, env=env, timeout=60)
        log(f"  -> youtube {action}: exit {r.returncode} {r.stdout.strip()[-120:]}")
        if r.returncode != 0:
            notify("Hey Claude: couldn't find a YouTube video in Chrome")
        return r.returncode
    if kind == "direct":
        from triage_router import try_direct_execution
        if try_direct_execution(q):
            return 0
        log("  -> direct failed, trying claude -p")
        kind = "quick"
    if kind == "math":
        from triage_router import evaluate_math_phrase
        answer = evaluate_math_phrase(q)
        notify(answer)
        speak(answer)
        return 0
    if kind == "time":
        now = time.strftime("%-I:%M %p")
        notify(now)
        speak(f"It's {now}")
        return 0
    if kind == "quick":
        # Detach so the Shortcut finishes now and "Hey Claude" is free again.
        notify(f"🎙️ {q}")
        subprocess.Popen([sys.executable, __file__, "--worker", *([] if submit else ["--no-send"]), q],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return 0
    if kind == "project":
        q = PROJECT.sub("", q, count=1) or q
    return 0 if send_to_claude(q, submit) else 1


if __name__ == "__main__":
    sys.exit(main())
