#!/usr/bin/env bash

PROMPT="$1"

if [ -z "$PROMPT" ]; then
    echo -e "\033[1;31m❌ [agy] Error: No prompt provided.\033[0m"
    exit 1
fi

echo -e "\033[1;34m🤖 [agy] Orchestrating architecture plan...\033[0m"

# Ensure the local tmp directory exists for our mechanical editor pipeline
mkdir -p tmp

# 1. THE INGESTION PIPELINE
# (Stub for future webpage-compressor integration as per architecture)
CONTEXT_PAYLOAD="You are operating in the ai-os directory. Evaluate the user request and generate the necessary codebase modifications."

# 2. THE DELEGATION PROTOCOL
# Construct the JSON payload for the local OpenRouter proxy (LiteLLM on port 4000)
# We demand a strict unified diff (.patch).
JSON_PAYLOAD=$(jq -n \
  --arg ctx "$CONTEXT_PAYLOAD" \
  --arg prompt "$PROMPT" \
  '{
    "model": "deepseek/deepseek-coder",
    "messages": [
      {
        "role": "system", 
        "content": "You are a mechanical code editor sub-agent. You MUST output ONLY a valid unified diff (.patch). Do not include conversational text, explanations, or markdown wrappers (like ```diff) outside of the raw patch output. Output the raw diff starting immediately with ---."
      },
      {
        "role": "user", 
        "content": ($ctx + "\n\nTask: " + $prompt)
      }
    ]
  }'
)

echo -e "\033[1;35m🧠 [agy] Delegating code generation to sub-agent via proxy...\033[0m"

# Call the local liteLLM proxy
RESPONSE=$(curl -s -X POST http://localhost:4000/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d "$JSON_PAYLOAD")

# Extract the content using jq
CONTENT=$(echo "$RESPONSE" | jq -r '.choices[0].message.content')

if [ "$CONTENT" == "null" ] || [ -z "$CONTENT" ]; then
    echo -e "\033[1;31m❌ [agy] Failed to get a valid response from the proxy.\033[0m"
    echo "Raw Response: $RESPONSE"
    exit 1
fi

# 3. THE MECHANICAL EDITOR
# Strip markdown codeblocks in case the LLM hallucinated them around the diff
echo "$CONTENT" | sed '/^```/d' > tmp/changes.patch

echo -e "\033[1;36m📝 [agy] Diff received. Executing mechanical patch...\033[0m"

# Output the patch to the UI so the user can verify what is happening
cat tmp/changes.patch
echo ""

# Apply the patch using the native Unix patch utility
if patch -p1 < tmp/changes.patch; then
    echo -e "\033[1;32m✅ [agy] File operations applied successfully.\033[0m"
else
    echo -e "\033[1;31m⚠️ [agy] Patch failed or partially applied. Check tmp/changes.patch\033[0m"
fi
