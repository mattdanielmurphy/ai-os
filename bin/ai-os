#!/usr/bin/env bash

# 1. Absolute anchor point
export AI_OS_HOME="/Users/matthewmurphy/projects/ai-os"

# 2. Global anchoring guardrails
# Ensures that wherever this is run, ~ has the exact same context
echo "[ai-os] Enforcing absolute context guardrails in ~/"
ln -sf "$AI_OS_HOME/CLAUDE.md" ~/CLAUDE.md
ln -sf "$AI_OS_HOME/MEMORY.md" ~/MEMORY.md
ln -sfn "$AI_OS_HOME/memory" ~/memory

# 3. Launch the App
# (For now we launch the dev server, later this will run the compiled binary)
cd "$AI_OS_HOME" || exit
echo "[ai-os] Launching interface..."
pnpm tauri dev