#!/usr/bin/env bash

export AI_OS_HOME="/Users/matt/projects/ai-os"

echo "[ai-os] Enforcing absolute context guardrails in ~/"
ln -sf "$AI_OS_HOME/CLAUDE.md" ~/CLAUDE.md
ln -sf "$AI_OS_HOME/docs/MEMORY.md" ~/MEMORY.md
export ZDOTDIR="$AI_OS_HOME"
ln -sfn "$AI_OS_HOME/docs/memory" ~/memory

# PHASE 4: macOS Profiling
# Generate a static state document of the environment on boot
PROFILE_PATH="$AI_OS_HOME/docs/memory/macOS_profile.md"
echo "[ai-os] Generating macOS system profile..."
echo "# macOS System Profile (Auto-Generated)" > "$PROFILE_PATH"
echo "## Storage & Volumes" >> "$PROFILE_PATH"
system_profiler SPStorageDataType >> "$PROFILE_PATH" 2>/dev/null
echo "## Active LaunchAgents" >> "$PROFILE_PATH"
ls -la ~/Library/LaunchAgents >> "$PROFILE_PATH" 2>/dev/null
echo "## Connected Displays" >> "$PROFILE_PATH"
system_profiler SPDisplaysDataType >> "$PROFILE_PATH" 2>/dev/null
echo "## Hammerspoon Config" >> "$PROFILE_PATH"
[ -f ~/.hammerspoon/init.lua ] && cat ~/.hammerspoon/init.lua | head -n 50 >> "$PROFILE_PATH" 2>/dev/null

# Generate the Stable Anchor Repo Map
echo "[ai-os] Updating Stable Anchor Repo Map..."
python3 "$AI_OS_HOME/scripts/generate_repo_map.py" "$AI_OS_HOME"

# Oneshot Hermes thread sync
echo "[ai-os] Running oneshot thread sync..."
python3 "$AI_OS_HOME/scripts/sync_threads.py" --oneshot

ORIGINAL_PWD="$PWD"
cd "$AI_OS_HOME" || exit

# Argument parsing
ENGINE="agy"
LAUNCH_GUI=true

show_help() {
    echo "AI-OS CLI - Command Line Interface for Personal AI OS"
    echo ""
    echo "Usage:"
    echo "  ai-os [options] [arguments]"
    echo ""
    echo "Options:"
    echo "  --gui           Launch the Tauri GUI dashboard (default)"
    echo "  --cli           Run the Agy orchestrator agent in the current terminal"
    echo "  --terminal      Run the Agy orchestrator agent in the current terminal"
    echo "  --no-gui        Run the Agy orchestrator agent in the current terminal"
    echo "  --agy           Run the Agy orchestrator agent in the current terminal"
    echo "  --claude        Run the native Claude Code agent in the current terminal"
    echo "  --handover      Compile thread context and spawn a fresh thread with process replacement"
    echo "  -h, --help      Show this help message"
    echo ""
    echo "All other arguments and flags are forwarded to the selected agent."
    exit 0
}

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        --gui)
            LAUNCH_GUI=true
            shift
            ;;
        --claude)
            ENGINE="claude"
            LAUNCH_GUI=false
            shift
            ;;
        --agy)
            ENGINE="agy"
            LAUNCH_GUI=false
            shift
            ;;
        --handover)
            exec python3 "$AI_OS_HOME/scripts/handover.py"
            ;;
        --cli|--no-gui|--terminal)
            LAUNCH_GUI=false
            shift
            ;;
        *)
            # Forward everything else to agent (only applicable if running non-GUI)
            break
            ;;
    esac
done

# Spawn background Hermes thread watcher
echo "[ai-os] Starting background thread sync watcher..."
python3 "$AI_OS_HOME/scripts/sync_threads.py" --watch &
SYNC_PID=$!
trap 'kill $SYNC_PID 2>/dev/null' EXIT

if [ "$LAUNCH_GUI" = true ]; then
    echo "[ai-os] Launching GUI interface..."
    export AIOS_INITIAL_PROJECT="$ORIGINAL_PWD"
    pnpm tauri dev
elif [ "$ENGINE" = "claude" ]; then
    echo "[ai-os] Launching Claude Code agent in terminal at $ORIGINAL_PWD..."
    cd "$ORIGINAL_PWD" || exit
    exec claude "$@" --dangerously-skip-permissions
else
    echo "[ai-os] Launching Agy orchestrator agent in terminal at $ORIGINAL_PWD..."
    cd "$ORIGINAL_PWD" || exit
    exec agy "$@" --dangerously-skip-permissions
fi