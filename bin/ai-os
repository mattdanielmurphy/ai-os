#!/usr/bin/env bash

export AI_OS_HOME="/Users/matthewmurphy/projects/ai-os"

echo "[ai-os] Enforcing absolute context guardrails in ~/"
ln -sf "$AI_OS_HOME/CLAUDE.md" ~/CLAUDE.md
ln -sf "$AI_OS_HOME/MEMORY.md" ~/MEMORY.md
export ZDOTDIR="$AI_OS_HOME"
ln -sfn "$AI_OS_HOME/memory" ~/memory

# PHASE 4: macOS Profiling
# Generate a static state document of the environment on boot
PROFILE_PATH="$AI_OS_HOME/memory/macOS_profile.md"
echo "[ai-os] Generating macOS system profile..."
echo "# macOS System Profile (Auto-Generated)" > "$PROFILE_PATH"
echo "## Storage & Volumes" >> "$PROFILE_PATH"
system_profiler SPStorageDataType >> "$PROFILE_PATH" 2>/dev/null
echo "## Active LaunchAgents" >> "$PROFILE_PATH"
ls -la ~/Library/LaunchAgents >> "$PROFILE_PATH" 2>/dev/null
echo "## Connected Displays" >> "$PROFILE_PATH"
system_profiler SPDisplaysDataType >> "$PROFILE_PATH" 2>/dev/null
echo "## Hammerspoon Config" >> "$PROFILE_PATH"
[ -f ~/.hammerspoon/init.lua ] && cat ~/.hammerspoon/init.lua | head -n 50 >> "$PROFILE_PATH" 2>/dev/null

cd "$AI_OS_HOME" || exit

# Argument parsing
ENGINE="agy"
LAUNCH_GUI=false

show_help() {
    echo "AI-OS CLI - Command Line Interface for Personal AI OS"
    echo ""
    echo "Usage:"
    echo "  ai-os [options] [arguments]"
    echo ""
    echo "Options:"
    echo "  --agy           Run the Agy orchestrator agent (default)"
    echo "  --claude        Run the native Claude Code agent"
    echo "  --gui           Launch the Tauri GUI dashboard"
    echo "  -h, --help      Show this help message"
    echo ""
    echo "All other arguments and flags are forwarded to the selected agent."
    exit 0
}

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        --gui)
            LAUNCH_GUI=true
            shift
            break
            ;;
        --claude)
            ENGINE="claude"
            shift
            break
            ;;
        --agy)
            ENGINE="agy"
            shift
            break
            ;;
        --cli)
            # Legacy flag, support and map to default (agy)
            shift
            ;;
        *)
            # Forward everything else
            break
            ;;
    esac
done

if [ "$LAUNCH_GUI" = true ]; then
    echo "[ai-os] Launching GUI interface..."
    pnpm tauri dev
elif [ "$ENGINE" = "claude" ]; then
    echo "[ai-os] Launching Claude Code agent..."
    exec claude "$@"
else
    echo "[ai-os] Launching Agy orchestrator agent..."
    exec agy "$@"
fi