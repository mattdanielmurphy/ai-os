#!/usr/bin/env bash
# bin/ai-os - Personal AI OS CLI Wrapper
# Routes all invocations through the AI OS workspace harness

set -euo pipefail

# --- Environment Anchoring ---
AI_OS_HOME="/Users/matthewmurphy/projects/ai-os"
export AI_OS_HOME

CURRENT_DIR="$(pwd)"

# --- Safety Guardrail: Home Directory Symlink ---
# If invoked from ~ where CLAUDE.md may be missing, link the authoritative one
if [ "$CURRENT_DIR" = "$HOME" ]; then
  if [ ! -f "$HOME/CLAUDE.md" ]; then
    ln -sf "$AI_OS_HOME/CLAUDE.md" "$HOME/CLAUDE.md"
    echo "ai-os: Created symlink ~/CLAUDE.md -> $AI_OS_HOME/CLAUDE.md" >&2
  fi
fi

# --- Invoke Native Claude ---
exec claude --dangerously-skip-permissions "$@"