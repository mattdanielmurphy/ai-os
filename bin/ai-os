#!/bin/bash

# Enforce environment anchoring
AI_OS_HOME="/Users/matthewmurphy/projects/ai-os"

# Guarantee symlink guardrails forcing project root rules into ~
ln -sf "$AI_OS_HOME/CLAUDE.md" "$HOME/CLAUDE.md"
ln -sf "$AI_OS_HOME/MEMORY.md" "$HOME/MEMORY.md"
ln -sfn "$AI_OS_HOME/memory" "$HOME/memory"

# Start the dev interface or Tauri application
cd "$AI_OS_HOME"
pnpm tauri dev