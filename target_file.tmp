        <!-- Right Sidebar for Thread Notes -->
        <div id="notes-sidebar-splitter" class="sidebar-splitter" data-ui="notes-sidebar-splitter"></div>
        <div
            id="thread-notes-sidebar"
            class="thread-notes-sidebar" data-ui="thread-notes-sidebar"
            style="width: 300px; display: flex; flex-direction: column; border-left: 1px solid var(--border-color); background: var(--panel-bg);"
        >
            <div class="sidebar-header" data-ui="notes-sidebar-header" style="padding: 10px; border-bottom: 1px solid var(--border-color); font-weight: bold;">
                <span>Thread Notes & Todos</span>
            </div>
            <div id="thread-notes-content" class="thread-notes-content" data-ui="thread-notes-content" style="flex: 1; overflow-y: auto; padding: 10px;">
                <!-- dynamic notes -->
            </div>
        </div>
    </body>
