{
  "manifest_version": 3,
  "name": "Tab Tidy",
  "version": "0.1.0",
  "description": "Groups your tabs by day and topic, and closes stale ones after saving them to an archive.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "history", "alarms", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Tab Tidy: click to tidy now" }
}
