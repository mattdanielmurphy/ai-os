#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/matthewmurphy/projects/ai-os/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/matthewmurphy/projects/ai-os/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/bash" ]; then
  exec "$basedir/bash"  "$basedir/../../bin/ai-os" "$@"
else
  exec bash  "$basedir/../../bin/ai-os" "$@"
fi
