rm() {
    echo "[AI-OS SYSTEM] 'rm' is physically disabled in this environment."
    echo "Use 'mv <file> ~/.Trash/' instead."
    return 1
}

qr() {
    local display_name="$1"
    shift
    
    # Rotate previous logs to keep the last 5
    for i in 4 3 2 1; do
        [ -f "/tmp/aios_last_cmd_${i}.log" ] && mv "/tmp/aios_last_cmd_${i}.log" "/tmp/aios_last_cmd_$((i+1)).log"
    done
    [ -f "/tmp/aios_last_cmd.log" ] && mv /tmp/aios_last_cmd.log /tmp/aios_last_cmd_1.log

    "$@" > /tmp/aios_last_cmd.log 2>&1
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        echo "✅ '$display_name' succeeded. (Output hidden to save tokens. Full log at /tmp/aios_last_cmd.log, previous 5 preserved as /tmp/aios_last_cmd_1.log etc)"
        tail -n 3 /tmp/aios_last_cmd.log
    else
        echo "❌ '$display_name' failed with exit code $exit_code."
        echo "--- ERROR EXTRACTION ---"
        if grep -iE "(error|exception|panic|fatal|traceback|fail)" /tmp/aios_last_cmd.log > /dev/null; then
            grep -iE -B 2 -A 5 "(error|exception|panic|fatal|traceback|fail)" /tmp/aios_last_cmd.log | tail -n 30
        else
            tail -n 20 /tmp/aios_last_cmd.log
        fi
        echo "------------------------"
        echo "ℹ️ Full error log available at: /tmp/aios_last_cmd.log (Previous logs at /tmp/aios_last_cmd_[1-5].log)"
        return $exit_code
    fi
}

# Auto-sync system rules on terminal load / git actions
sync_rules() {
    if [ -f "/Users/matthewmurphy/projects/ai-os/scripts/sync_rules.sh" ]; then
        /Users/matthewmurphy/projects/ai-os/scripts/sync_rules.sh > /dev/null 2>&1 || true
    fi
}

# Run sync on shell initialization
sync_rules

# Intercept Git actions to sync rules before stage/commit/status inspects
git() {
    local cmd="$1"
    if [[ "$cmd" == "status" || "$cmd" == "add" || "$cmd" == "commit" || "$cmd" == "diff" ]]; then
        sync_rules
    fi
    
    if [[ "$cmd" == "commit" ]]; then
        qr "git commit" command git "$@"
        return $?
    fi
    
    command git "$@"
}

# --- AI-OS AGGRESSIVE WHITELIST ---
# Add noisy commands to this array. An agent can easily edit this array during a token audit.
# The shell will automatically route these commands through the `qr` (Quiet Run) wrapper.
NOISY_COMMANDS=(
    "npm" "pnpm" "yarn" "pip" "pip3" "cargo" "make" "docker" "docker-compose" "pytest" "jest" "tsc" "rustc" "go"
)

for cmd in "${NOISY_COMMANDS[@]}"; do
    if command -v "$cmd" >/dev/null 2>&1; then
        eval "
        ${cmd}() {
            qr \"${cmd}\" command ${cmd} \"\$@\"
        }
        "
    fi
done

