rm() {
    echo "[AI-OS SYSTEM] 'rm' is physically disabled in this environment."
    echo "Use 'mv <file> ~/.Trash/' instead."
    return 1
}

qr() {
    "$@" > /tmp/aios_last_cmd.log 2>&1
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        echo "✅ Success. (Full log at /tmp/aios_last_cmd.log)"
    else
        echo "❌ Failed! Last 20 lines of error:"
        tail -n 20 /tmp/aios_last_cmd.log
        return $exit_code
    fi
}
