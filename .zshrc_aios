rm() {
    echo "[AI-OS SYSTEM] 'rm' is physically disabled in this environment."
    echo "Use 'mv <file> ~/.Trash/' instead."
    return 1
}

qr() {
    "$@" > /tmp/aios_last_cmd.log 2>&1
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        echo "✅ Success. (Full log at /tmp/aios_last_cmd.log)"
    else
        echo "❌ Failed! Last 20 lines of error:"
        tail -n 20 /tmp/aios_last_cmd.log
        return $exit_code
    fi
}

# Auto-sync system rules on terminal load / git actions
sync_rules() {
    if [ -f "/Users/matthewmurphy/projects/ai-os/scripts/sync_rules.sh" ]; then
        /Users/matthewmurphy/projects/ai-os/scripts/sync_rules.sh > /dev/null 2>&1 || true
    fi
}

# Run sync on shell initialization
sync_rules

# Intercept Git actions to sync rules before stage/commit/status inspects
git() {
    local cmd="$1"
    if [[ "$cmd" == "status" || "$cmd" == "add" || "$cmd" == "commit" || "$cmd" == "diff" ]]; then
        sync_rules
    fi
    
    if [[ "$cmd" == "commit" ]]; then
        qr command git "$@"
        return $?
    fi
    
    command git "$@"
}

# Intercept noisy commands and execute them quietly
npm() {
    if [[ "$1" == "install" || "$1" == "i" || "$1" == "ci" ]]; then
        qr command npm "$@"
        return $?
    fi
    command npm "$@"
}

pnpm() {
    if [[ "$1" == "install" || "$1" == "i" ]]; then
        qr command pnpm "$@"
        return $?
    fi
    command pnpm "$@"
}

pip() {
    if [[ "$1" == "install" ]]; then
        qr command pip "$@"
        return $?
    fi
    command pip "$@"
}

cargo() {
    if [[ "$1" == "build" || "$1" == "b" || "$1" == "install" || "$1" == "check" || "$1" == "c" ]]; then
        qr command cargo "$@"
        return $?
    fi
    command cargo "$@"
}

